# Copied to /opt/status-monitor/.env (mode 600) by setup.sh. Edit it on the
# server with: sudo nano /opt/status-monitor/.env    Never commit the real file.

# Sites to monitor, separated by commas or newlines (newlines need quotes).
# Each entry is Name=https://... or just https://... (name defaults to the host).
MONITOR_URLS="Website=https://example.com,API=https://api.example.com/health"

# The status page's exact origin (scheme + host, no trailing slash).
ALLOWED_ORIGIN=https://status.example.com

# Seconds between check rounds.
INTERVAL_SECONDS=30

# Optional tuning (defaults shown):
# SLOW_MS=2000
# TIMEOUT_MS=10000
# RETENTION_DAYS=30

# Cloudflare R2 (Litestream replica). Leave all four empty to disable replication.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=status-monitor-db

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
TUNNEL_TOKEN=
